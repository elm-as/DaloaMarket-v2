# ── HTTP Cache Headers for Netlify ──

# Assets immutables compilés par Vite (JS, CSS, WebP, SVG, PNG avec hash)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons et images statiques du dossier public
/favicon.ico
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
/android-chrome-192x192.png
  Cache-Control: public, max-age=2592000
/android-chrome-512x512.png
  Cache-Control: public, max-age=2592000
/logo.png
  Cache-Control: public, max-age=2592000

# HTML principal & Service Worker (revalidation rapide pour les mises à jour)
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/service-worker.js
  Cache-Control: public, max-age=0, must-revalidate
/manifest.json
  Cache-Control: public, max-age=86400
